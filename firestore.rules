rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidSavedAdAsset(data) {
      return data.keys().hasAll([
        'ownerId',
        'assetType',
        'title',
        'primaryText',
        'secondaryText',
        'aspectRatio',
        'imageDataUrl',
        'category',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'assetType',
        'title',
        'primaryText',
        'secondaryText',
        'aspectRatio',
        'imageDataUrl',
        'category',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.assetType is string &&
      data.assetType in ['image', 'logo', 'headline', 'description', 'facebook_ad', 'campaign_bundle'] &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
      data.primaryText is string && data.primaryText.size() <= 2000 &&
      data.secondaryText is string && data.secondaryText.size() <= 500 &&
      data.aspectRatio is string && data.aspectRatio.size() <= 20 &&
      data.imageDataUrl is string && data.imageDataUrl.size() <= 750000 &&
      data.category is string && data.category.size() <= 80 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLinkedSheetSync(data) {
      return data.keys().hasAll([
        'ownerId',
        'spreadsheetId',
        'sheetTitle',
        'spreadsheetUrl',
        'autoSyncEnabled',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'spreadsheetId',
        'sheetTitle',
        'spreadsheetUrl',
        'autoSyncEnabled',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.spreadsheetId is string && data.spreadsheetId.size() >= 5 && data.spreadsheetId.size() <= 128 &&
      data.sheetTitle is string && data.sheetTitle.size() >= 1 && data.sheetTitle.size() <= 200 &&
      data.spreadsheetUrl is string && data.spreadsheetUrl.size() <= 500 &&
      data.autoSyncEnabled is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAdCreatorReminder(data) {
      return data.keys().hasAll([
        'ownerId',
        'title',
        'notes',
        'dueAtIso',
        'frequency',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'title',
        'notes',
        'dueAtIso',
        'frequency',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
      data.notes is string && data.notes.size() <= 500 &&
      data.dueAtIso is string && data.dueAtIso.size() <= 64 &&
      data.frequency is string && data.frequency in ['once', 'daily', 'weekly'] &&
      data.status is string && data.status in ['active', 'completed'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /ad_assets/{assetId} {
      allow get: if isSignedIn() && isValidId(assetId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(assetId) && isValidSavedAdAsset(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(assetId) && isValidSavedAdAsset(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'primaryText',
          'secondaryText',
          'aspectRatio',
          'imageDataUrl',
          'category',
          'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(assetId) && existing().ownerId == request.auth.uid;
    }

    match /linked_sheets/{sheetDocId} {
      allow get: if isSignedIn() && isValidId(sheetDocId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(sheetDocId) && isValidLinkedSheetSync(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(sheetDocId) && isValidLinkedSheetSync(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'spreadsheetId',
          'sheetTitle',
          'spreadsheetUrl',
          'autoSyncEnabled',
          'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(sheetDocId) && existing().ownerId == request.auth.uid;
    }

    match /ad_reminders/{reminderId} {
      allow get: if isSignedIn() && isValidId(reminderId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(reminderId) && isValidAdCreatorReminder(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(reminderId) && isValidAdCreatorReminder(incoming()) &&
        existing().ownerId == request.auth.uid &&
        existing().status != 'completed' &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'notes',
          'dueAtIso',
          'frequency',
          'status',
          'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(reminderId) && existing().ownerId == request.auth.uid;
    }
  }
}
